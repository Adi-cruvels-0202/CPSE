# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Supabase — https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses RLS. Server-side only — never send it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection — only `npm run db:migrate` uses it.
# Dashboard -> Project Settings -> Database -> Connection string -> Session pooler,
# with your database password substituted for [YOUR-PASSWORD].
# Leave unset to apply migrations by pasting `npm run db:print` into the SQL editor.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Where the password-reset email sends the customer. Add this exact URL to
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
