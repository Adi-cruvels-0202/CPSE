# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Supabase — https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses RLS. Server-side only — never send it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Where the password-reset email sends the customer. Add this exact URL to
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Writes that cost real work (placing an order, initiating a payment).
WRITE_RATE_LIMIT_MAX=60
# Per minute, and deliberately generous: a 429 makes a real gateway retry the
# same event for hours, and the HMAC signature is the real gate there.
WEBHOOK_RATE_LIMIT_MAX=120

# Largest request body accepted. A cart line or an address is a few hundred bytes.
JSON_BODY_LIMIT=32kb

# Payments (decision D7). `mock` is the only provider implemented so far.
PAYMENT_PROVIDER=mock
# Shared secret the gateway signs webhooks with. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string
PAYMENT_MOCK_CHECKOUT_URL=http://localhost:5173/mock-payment

# Test-only endpoint that advances an order's status in place of a merchant
# dashboard (checklist 8.8). The app refuses to boot with this true in production.
ENABLE_TEST_ENDPOINTS=false
