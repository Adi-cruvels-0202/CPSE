{
  "name": "cpse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer Portal & Shopping Experience — backend API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=./src --watch-preserve-output src/server.js",
    "start": "node src/server.js",
    "start:static": "SERVE_STATIC_FRONTEND=true node src/server.js",
    "service": "node src/service.js",
    "build": "npm --prefix ../frontend/customer ci --include=dev && npm --prefix ../frontend/customer run build && npm --prefix ../frontend/merchant ci --include=dev && npm --prefix ../frontend/merchant run build",
    "build:frontends": "npm --prefix ../frontend/customer run build && npm --prefix ../frontend/merchant run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed": "node scripts/seed.js",
    "db:maintenance": "node scripts/maintenance.js"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
