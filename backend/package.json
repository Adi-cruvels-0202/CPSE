{
  "name": "cpse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer Portal & Shopping Experience \u2014 backend API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
