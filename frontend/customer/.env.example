# Copy to .env and adjust. Never commit .env.
# Vite only exposes variables prefixed with VITE_ to the browser — so nothing
# secret belongs in this file at all. It is all public by the time it ships.

# Where the backend lives. The path must include the version prefix.
# The backend serves this app from its own port, so the default is relative and
# needs no origin. Point it at an absolute URL only if the API moves elsewhere.
VITE_API_BASE_URL=/api/v1
